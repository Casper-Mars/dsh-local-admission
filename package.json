{
  "name": "dsh-bypass-web-token",
  "version": "0.1.0",
  "description": "Cordis plugin for dsh: tokenless UI, /api and WebSocket admission as an anonymous owner peer (zero-config, any bind address)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casper-Mars/dsh-bypass-web-token.git"
  },
  "homepage": "https://github.com/Casper-Mars/dsh-bypass-web-token#readme",
  "bugs": {
    "url": "https://github.com/Casper-Mars/dsh-bypass-web-token/issues"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "token",
    "bypass",
    "developer-tools"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "setup": "node scripts/setup-profile.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@types/node": "^26.6.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
